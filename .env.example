# Copy to .env and fill in. `cp .env.example .env` (or `make setup`).

# --- LLM provider ---
# All lesson models route through Tikal's hosted LiteLLM proxy. No direct
# provider keys (OPENAI_API_KEY / ANTHROPIC_API_KEY) are used.
# Don't have a LITELLM_API_KEY yet? Ask Tomer Feiler.
LITELLM_PROXY_URL=https://litellm.tikalk.dev
LITELLM_API_KEY=

# --- Model ---
# Your key may be scoped to a subset of models. If you get
# "key not allowed to access model", set this to a model your key allows
# (ask Tomer, or try `open-weight-smart`).
BALANCED_MODEL=open-weight-smart

# --- Web search (lesson 6) ---
# Get a key from https://app.tavily.com. Required when Studio loads lesson 6.
TAVILY_API_KEY=
